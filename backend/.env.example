# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
ALLOWED_EMAIL_DOMAIN=*

# Database Connection (PostgreSQL)
# e.g., postgresql://username:password@localhost:5432/c2c_db or Neon connection URL
DATABASE_URL=postgresql://user:password@localhost:5432/c2c?sslmode=disable

# Cache Connection (Redis)
# e.g., redis://localhost:6379 or Upstash Redis URL
REDIS_URL=redis://localhost:6379

# Authentication (JWT Secret)
JWT_SECRET=replace_with_a_secure_random_string

# Google OAuth Credentials
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Media Storage (Cloudinary Credentials)
CLOUDINARY_CLOUD_NAME=replace_with_cloudinary_cloud_name
CLOUDINARY_API_KEY=replace_with_cloudinary_api_key
CLOUDINARY_API_SECRET=replace_with_cloudinary_api_secret
